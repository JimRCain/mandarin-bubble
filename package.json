{
  "name": "mandarin-bubble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Mandarin vocabulary learning tool masquerading as an arcade game.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "tsc --noEmit && npm run content:build && vite build",
    "build:web": "npm run content:build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "node scripts/content-validate.mjs",
    "content:build": "node scripts/content-build.mjs",
    "content:migrate": "node scripts/content-migrate.mjs",
    "verify": "npm run typecheck && npm run lint && npm run content:validate && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}